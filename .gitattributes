# ============================================================
# .gitattributes — asv_backend
# Menandai tipe file untuk diff & konflik yang lebih bersih.
# ============================================================

# Binary / hasil training — tidak pernah di-diff sebagai teks
*.onnx binary

# Gambar & video
*.jpg  binary
*.jpeg binary
*.png  binary
*.mp4  binary
*.avi  binary

# Semua teks Wajib LF (hindari perang CRLF antar anggota)
* text=auto eol=lf
*.py  text eol=lf
*.c   text eol=lf
*.cpp text eol=lf
*.h   text eol=lf
*.hpp text eol=lf
*.md  text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.sh  text eol=lf
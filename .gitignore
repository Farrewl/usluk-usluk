# ============================================================
# .gitignore — asv_backend
# File besar / output runtime TIDAK di-versi-git.
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv_backup*/
venv/

# Output runtime (folder kerja kapal)
data/*
!data/README.md

# Model YOLO (ONNX) — DI-VERSI-GIT (dipakai langsung setelah clone, tanpa unduh)
# agar teman bisa "clone lalu jalan" tanpa langkah manual.
# weights/*.onnx

# Media (dulu pernah ter-track, sekarang tidak)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp
*.mp4
*.avi

# Peta sementara yang di-generate GUI
temp_map.html

# OS
.DS_Store
Thumbs.db

# Editor / tooling
.vscode/
.idea/
*.swp

# Arsip referensi lokal (jangan di-commit)
*.zip
*.7z
*.rar

# Build artifacts (lokal, beda tiap mesin)
*.so
*.dll
core/build/
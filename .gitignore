# ============================================================
# .gitignore — asv_backend
# File besar / output runtime TIDAK di-versi-git.
# (File yang dulu sudah ter-track tetap di history; lihat docs/ARCHITECTURE.md)
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv_backup*/
venv/

# Output runtime (folder kerja kapal)
data/*
!data/README.md

# Model YOLO — DI-VERSI-GIT (dipakai langsung setelah clone, tanpa unduh)
# agar teman bisa "clone lalu jalan" tanpa langkah manual.
# Bila nanti berat, aktifkan lagi baris di bawah.
# weights/*.pt

# Media (dulu pernah ter-track, sekarang tidak)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.webp
*.mp4
*.avi

# Peta sementara yang di-generate GUI
temp_map.html

# OS
.DS_Store
Thumbs.db

# Editor / tooling
.vscode/
.idea/
*.swp

# Build artifacts (lokal, beda tiap mesin)
*.so
*.dll
core/build/
# kecuali DLL Windows prebuilt (opsional, biar teman tanpa MinGW bisa jalan)
!core/aterkia_core.dll